{
  "name": "forever-games",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "corepack pnpm db:generate && corepack pnpm --filter @forever-games/web dev",
    "build": "corepack pnpm --filter @forever-games/web build",
    "lint": "corepack pnpm --filter @forever-games/web lint",
    "typecheck": "corepack pnpm --filter @forever-games/web typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "test:component": "vitest run tests/component",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:full": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:security": "vitest run tests/security",
    "test:performance": "vitest run tests/performance",
    "db:generate": "node scripts/run-prisma.mjs generate",
    "db:migrate": "node scripts/run-prisma.mjs migrate dev --name local-change",
    "db:seed": "tsx packages/db/prisma/seed.ts",
    "db:migration:test": "node scripts/run-prisma.mjs validate"
    ,"db:migrate:deploy": "node scripts/migrate-deploy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@prisma/client": "6.11.1",
    "@vitest/coverage-v8": "3.2.6",
    "prisma": "6.11.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  },
  "prisma": { "seed": "tsx packages/db/prisma/seed.ts" }
}
