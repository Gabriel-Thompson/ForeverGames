generator client {
  provider = "prisma-client"
  output   = "../generated/client-v3"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}
enum UserRole {
  MEMBER
  SUPPORT
  CURATOR
  ANALYST
  ADMIN
}
enum EvidenceValidationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}
enum ProviderCode {
  MOCK_STEAM
  STEAM
  XBOX_EVIDENCE
  PLAYSTATION_EVIDENCE
  NINTENDO_EVIDENCE
  EPIC_EVIDENCE
  GOG_EVIDENCE
  MANUAL
}
enum ConnectionStatus {
  PENDING
  CONNECTED
  BLOCKED_PRIVACY
  EXPIRED
  ERROR
  DISCONNECTED
}
enum SyncStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}
enum AccessType {
  PURCHASED
  SUBSCRIPTION_ACCESS
  FREE_ACCESS
  IMPORTED
  SELF_REPORTED
  UNKNOWN
}
enum VerificationLevel {
  VERIFIED_PROVIDER
  VERIFIED_EVIDENCE
  IMPORTED_UNVERIFIED
  SELF_REPORTED
}
enum EntitlementStatus {
  ACTIVE
  NOT_SEEN
  REMOVED_OR_INACCESSIBLE
  DISPUTED
}
enum MappingStatus {
  AUTO_MATCHED
  APPROVED
  AMBIGUOUS
  UNMATCHED
  REJECTED
}
enum PhysicalStatus {
  PHYSICAL_AVAILABLE
  DIGITAL_ONLY
  LIMITED_PHYSICAL
  UNKNOWN
  PARTNER_APPROVED_FUTURE
}
enum ReservationStatus {
  ACTIVE
  CANCELLED
  CONVERTED_TO_OFFER
  EXPIRED
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  displayName  String
  region       String
  status       UserStatus           @default(ACTIVE)
  role         UserRole             @default(MEMBER)
  createdAt    DateTime             @default(now())
  consents     Consent[]
  connections  ProviderConnection[]
  reservations Reservation[]
  sessions     Session[]
  evidence     PurchaseEvidence[]
  partnershipVotes PartnershipVote[]
}

model PartnershipVote {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider])
  @@index([provider])
}

model PurchaseEvidence {
  id              String   @id @default(cuid())
  userId          String
  entitlementId   String   @unique
  provider        ProviderCode
  originalName    String
  mimeType        String
  fileSize        Int
  documentHash    String
  storageRef      String
  orderReference  String?
  purchaseDate    DateTime?
  importedAt      DateTime @default(now())
  validationStatus EvidenceValidationStatus @default(PENDING_REVIEW)
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlement     Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  @@index([userId, importedAt])
  @@unique([userId, documentHash])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Consent {
  id         String   @id @default(cuid())
  userId     String
  type       String
  version    String
  accepted   Boolean
  acceptedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type, version])
}

model ProviderConnection {
  id                   String           @id @default(cuid())
  userId               String
  provider             ProviderCode
  externalAccountHash  String
  externalAccountId    String?
  status               ConnectionStatus @default(PENDING)
  capabilities         String[]
  credentialCiphertext String?
  lastSyncedAt         DateTime?
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns             SyncRun[]
  entitlements         Entitlement[]
  credential           ProviderCredential?
  @@unique([provider, externalAccountHash])
}

model ProviderCredential {
  id           String             @id @default(cuid())
  connectionId String             @unique
  ciphertext   String
  iv           String
  authTag      String
  keyVersion   String
  expiresAt    DateTime?
  scopes       String[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  connection   ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model SyncRun {
  id           String             @id @default(cuid())
  connectionId String
  status       SyncStatus         @default(QUEUED)
  cursor       String?
  imported     Int                @default(0)
  mapped       Int                @default(0)
  unmatched    Int                @default(0)
  attempt      Int                @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  connection   ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model CatalogGame {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String?
  publisher   String?
  developer   String?
  releaseYear Int?
  genre       String?
  imageUrl    String?
  metadataSource String?
  externalStoreId String?
  releases    CatalogRelease[]
  createdAt   DateTime         @default(now())
}

model CatalogRelease {
  id             String         @id @default(cuid())
  gameId         String
  platform       String
  region         String         @default("GLOBAL")
  edition        String         @default("DIGITAL")
  physicalStatus PhysicalStatus @default(UNKNOWN)
  source         String
  sourceRights   String
  game           CatalogGame    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  entitlements   Entitlement[]
  reservations   Reservation[]
  mappings       ProductMapping[]
  @@unique([gameId, platform, region, edition])
}

model ProductMapping {
  id                String         @id @default(cuid())
  provider          ProviderCode
  externalProductId String
  releaseId         String?
  status            MappingStatus
  confidence        Float?
  method            String?
  release           CatalogRelease? @relation(fields: [releaseId], references: [id])
  @@unique([provider, externalProductId])
}

model Entitlement {
  id                String              @id @default(cuid())
  connectionId      String
  externalProductId String
  releaseId         String?
  accessType        AccessType
  verification      VerificationLevel
  status            EntitlementStatus   @default(ACTIVE)
  firstSeenAt       DateTime             @default(now())
  lastSeenAt        DateTime             @default(now())
  sourcePayloadHash String
  connection        ProviderConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  release           CatalogRelease?     @relation(fields: [releaseId], references: [id])
  evidence          PurchaseEvidence?
  @@unique([connectionId, externalProductId, accessType])
}

model Reservation {
  id                 String              @id @default(cuid())
  userId             String
  releaseId          String
  editionType        String
  targetPriceBand    String
  shippingCountry    String
  platformPreference String?
  caseType            String?
  extras              String[]
  comments            String?
  disclosureVersion  String
  status             ReservationStatus   @default(ACTIVE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  release            CatalogRelease       @relation(fields: [releaseId], references: [id])
  history            ReservationHistory[]
  commands           ReservationCommand[]
  @@unique([userId, releaseId, editionType])
}

model ReservationCommand {
  id             String @id @default(cuid())
  reservationId  String
  idempotencyKey String @unique
  response       Json
  createdAt      DateTime @default(now())
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model ReservationHistory {
  id            String      @id @default(cuid())
  reservationId String
  action        String
  snapshot      Json
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now())
  @@index([createdAt])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  aggregateId String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  @@index([publishedAt, createdAt])
}
