# Copy to .env.local. Never commit .env.local or real credentials.
APP_ENV=local
LOCAL_ADMIN_EMAILS=admin@example.local
PUBLIC_BASE_URL=http://localhost:3000
CANONICAL_DOMAIN=localhost
DATABASE_URL=postgresql://forever_games:forever_games@localhost:5432/forever_games?schema=public
DIRECT_URL=postgresql://forever_games:forever_games@localhost:5432/forever_games?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=replace-with-a-local-32-byte-random-key
STEAM_WEB_API_KEY=
STEAM_REALM=http://localhost:3000
STEAM_RETURN_URL=http://localhost:3000/api/v1/connections/steam/callback
CATALOG_PROVIDER=mock
CATALOG_CLIENT_ID=
CATALOG_CLIENT_SECRET=
EMAIL_PROVIDER=mailpit
EMAIL_FROM=archive@forevergames.local
ANALYTICS_WRITE_KEY=
OTEL_EXPORTER=
ERROR_TRACKING_DSN=
ENABLE_REAL_STEAM=false
ENABLE_SYNTHETIC_FALLBACK=true
ENABLE_EVIDENCE_UPLOADS=true
MAINTENANCE_MODE=false
PUBLIC_REGISTRATION_ENABLED=true
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
PUBLIC_DEMAND_MIN_CELL=3
OPENXBL_API_KEY=
OPENXBL_BASE_URL=https://xbl.io
ENABLE_CHECKOUT=false
